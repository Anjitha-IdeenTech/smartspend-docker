# Copy to .env in the repository root (not into deploy/) and fill in.

# The hostname the client opens. One DNS A record must point it at this
# machine's public IP. The Odoo backend, if you keep that block in the
# Caddyfile, is odoo.<this> and needs a second record.
SMARTSPEND_DOMAIN=smartspend-demo.ideenkreisetech.com

# Where Let's Encrypt writes if a certificate ever fails to renew. Optional.
SMARTSPEND_ADMIN_EMAIL=anjitha@ideenkreisetech.com

# Postgres' password inside the compose network. Any long random string:
#     openssl rand -hex 24
POSTGRES_PASSWORD=
