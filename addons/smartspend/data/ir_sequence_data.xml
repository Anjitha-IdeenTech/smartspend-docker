<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="seq_smartspend_request" model="ir.sequence">
            <field name="name">SmartSpend Purchase Request</field>
            <field name="code">smartspend.request</field>
            <field name="prefix">PR-%(year)s-</field>
            <field name="padding">3</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_smartspend_contract" model="ir.sequence">
            <field name="name">SmartSpend Rate Contract</field>
            <field name="code">smartspend.contract</field>
            <field name="prefix">RC-%(year)s-</field>
            <field name="padding">3</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
        </record>


        <record id="seq_smartspend_workflow" model="ir.sequence">
            <field name="name">SmartSpend Approval Workflow</field>
            <field name="code">smartspend.workflow</field>
            <field name="prefix">COMP-APPROVE/</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
        </record>

    </data>
</odoo>
