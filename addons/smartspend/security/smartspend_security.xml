<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="module_category_smartspend" model="ir.module.category">
        <field name="name">SmartSpend</field>
        <field name="description">Access to the SmartSpend procurement copilot.</field>
        <field name="sequence">20</field>
    </record>

    <record id="res_groups_privilege_smartspend" model="res.groups.privilege">
        <field name="name">SmartSpend</field>
        <field name="sequence">20</field>
        <field name="category_id" ref="module_category_smartspend"/>
        <field name="placeholder">No access</field>
    </record>

    <record id="group_smartspend_user" model="res.groups">
        <field name="name">Requester</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_smartspend"/>
        <!-- Analytic accounting, as Odoo's setting turns on: every requester
             splits a line's cost across analytic accounts. -->
        <field name="implied_ids" eval="[Command.link(ref('base.group_user')), Command.link(ref('analytic.group_analytic_accounting'))]"/>
        <field name="comment">Raise purchase requests and follow their own ones.</field>
    </record>

    <!-- A buyer sources requests and raises the orders, so they carry the Odoo
         purchase role as well; a requester deliberately does not. -->
    <record id="group_smartspend_buyer" model="res.groups">
        <field name="name">SCM Buyer</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_smartspend"/>
        <field name="implied_ids" eval="[
            Command.link(ref('group_smartspend_user')),
            Command.link(ref('purchase.group_purchase_user')),
        ]"/>
        <field name="comment">Source every request, maintain rate contracts and raise purchase orders.</field>
    </record>

    <record id="group_smartspend_manager" model="res.groups">
        <field name="name">Procurement Manager</field>
        <field name="sequence">30</field>
        <field name="privilege_id" ref="res_groups_privilege_smartspend"/>
        <field name="implied_ids" eval="[
            Command.link(ref('group_smartspend_buyer')),
            Command.link(ref('purchase.group_purchase_manager')),
        ]"/>
        <field name="user_ids" eval="[Command.link(ref('base.user_root')), Command.link(ref('base.user_admin'))]"/>
        <field name="comment">Approve requests, and reset the demo data through the portal API.</field>
    </record>

    <!-- An external supplier signing in to quote. It implies the requester group
         only so the portal API authenticates and the record rules apply; it
         grants nothing of its own, and the "own requests" rule below means a
         vendor account reads no other company's requests. -->
    <record id="group_smartspend_vendor" model="res.groups">
        <field name="name">Vendor (External)</field>
        <field name="sequence">5</field>
        <field name="privilege_id" ref="res_groups_privilege_smartspend"/>
        <field name="implied_ids" eval="[Command.link(ref('group_smartspend_user'))]"/>
        <field name="comment">External supplier: quote against RFQs shared with them.</field>
    </record>

    <!-- A requester sees the requests they raised; buyers and managers see all. -->
    <record id="rule_smartspend_request_own" model="ir.rule">
        <field name="name">SmartSpend: own purchase requests</field>
        <field name="model_id" ref="model_smartspend_request"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[Command.link(ref('group_smartspend_user'))]"/>
    </record>

    <record id="rule_smartspend_request_all" model="ir.rule">
        <field name="name">SmartSpend: all purchase requests</field>
        <field name="model_id" ref="model_smartspend_request"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[Command.link(ref('group_smartspend_buyer'))]"/>
    </record>

    <!-- A supplier has to read the orders placed with them, or their portal has
         nothing in it — and only those: an order is theirs when the request's
         vendor is their company (the contact their login sits under), so one
         supplier never reads another's orders, items or timeline. Rules from different groups are OR'd, so this sits
         alongside the "own requests" rule the vendor group inherits: they see
         anything that has reached a purchase order, and their own requisitions
         if they ever raise one. Read only — a vendor acknowledging an order
         goes through the gated endpoint, which writes with elevated rights. -->
    <record id="rule_smartspend_request_vendor" model="ir.rule">
        <field name="name">SmartSpend: orders placed with a vendor</field>
        <field name="model_id" ref="model_smartspend_request"/>
        <field name="domain_force">[('state', 'in', ['po_confirmed', 'paid']), ('partner_id.commercial_partner_id', '=', user.commercial_partner_id.id)]</field>
        <field name="groups" eval="[Command.link(ref('group_smartspend_vendor'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_smartspend_request_line_vendor" model="ir.rule">
        <field name="name">SmartSpend: lines of orders placed with a vendor</field>
        <field name="model_id" ref="model_smartspend_request_line"/>
        <field name="domain_force">[('request_id.state', 'in', ['po_confirmed', 'paid']), ('request_id.partner_id.commercial_partner_id', '=', user.commercial_partner_id.id)]</field>
        <field name="groups" eval="[Command.link(ref('group_smartspend_vendor'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_smartspend_request_history_vendor" model="ir.rule">
        <field name="name">SmartSpend: timeline of orders placed with a vendor</field>
        <field name="model_id" ref="model_smartspend_request_history"/>
        <field name="domain_force">[('request_id.state', 'in', ['po_confirmed', 'paid']), ('request_id.partner_id.commercial_partner_id', '=', user.commercial_partner_id.id)]</field>
        <field name="groups" eval="[Command.link(ref('group_smartspend_vendor'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- The child records inherit the visibility of the request they hang off.
         Without these, a requester who may only see their own requests could
         still read every line, bid and timeline entry in the database. -->
    <record id="rule_smartspend_request_line_own" model="ir.rule">
        <field name="name">SmartSpend: own request lines</field>
        <field name="model_id" ref="model_smartspend_request_line"/>
        <field name="domain_force">[('request_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[Command.link(ref('group_smartspend_user'))]"/>
    </record>
    <record id="rule_smartspend_request_line_all" model="ir.rule">
        <field name="name">SmartSpend: all request lines</field>
        <field name="model_id" ref="model_smartspend_request_line"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[Command.link(ref('group_smartspend_buyer'))]"/>
    </record>

    <record id="rule_smartspend_request_bid_own" model="ir.rule">
        <field name="name">SmartSpend: own request bids</field>
        <field name="model_id" ref="model_smartspend_request_bid"/>
        <field name="domain_force">[('request_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[Command.link(ref('group_smartspend_user'))]"/>
    </record>
    <record id="rule_smartspend_request_bid_all" model="ir.rule">
        <field name="name">SmartSpend: all request bids</field>
        <field name="model_id" ref="model_smartspend_request_bid"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[Command.link(ref('group_smartspend_buyer'))]"/>
    </record>

    <record id="rule_smartspend_request_history_own" model="ir.rule">
        <field name="name">SmartSpend: own request timeline</field>
        <field name="model_id" ref="model_smartspend_request_history"/>
        <field name="domain_force">[('request_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[Command.link(ref('group_smartspend_user'))]"/>
    </record>
    <record id="rule_smartspend_request_history_all" model="ir.rule">
        <field name="name">SmartSpend: all request timelines</field>
        <field name="model_id" ref="model_smartspend_request_history"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[Command.link(ref('group_smartspend_buyer'))]"/>
    </record>

    <record id="rule_smartspend_request_comment_own" model="ir.rule">
        <field name="name">SmartSpend: own clarifications</field>
        <field name="model_id" ref="model_smartspend_request_comment"/>
        <field name="domain_force">[('request_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[Command.link(ref('group_smartspend_user'))]"/>
    </record>
    <record id="rule_smartspend_request_comment_all" model="ir.rule">
        <field name="name">SmartSpend: all clarifications</field>
        <field name="model_id" ref="model_smartspend_request_comment"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[Command.link(ref('group_smartspend_buyer'))]"/>
    </record>

    <record id="rule_smartspend_request_document_own" model="ir.rule">
        <field name="name">SmartSpend: own request documents</field>
        <field name="model_id" ref="model_smartspend_request_document"/>
        <field name="domain_force">[('request_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[Command.link(ref('group_smartspend_user'))]"/>
    </record>
    <record id="rule_smartspend_request_document_all" model="ir.rule">
        <field name="name">SmartSpend: all request documents</field>
        <field name="model_id" ref="model_smartspend_request_document"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[Command.link(ref('group_smartspend_buyer'))]"/>
    </record>

    <!-- An approver can put a question to someone other than the requester.
         That person reads the request so they can answer it — read only; the
         answer itself goes through /api/smartspend/clarify-reply. -->
    <record id="rule_smartspend_request_asked" model="ir.rule">
        <field name="name">SmartSpend: requests I was asked about</field>
        <field name="model_id" ref="model_smartspend_request"/>
        <field name="domain_force">[('clarification_user_id', '=', user.id)]</field>
        <field name="groups" eval="[Command.link(ref('group_smartspend_user'))]"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_smartspend_request_line_asked" model="ir.rule">
        <field name="name">SmartSpend: lines of requests I was asked about</field>
        <field name="model_id" ref="model_smartspend_request_line"/>
        <field name="domain_force">[('request_id.clarification_user_id', '=', user.id)]</field>
        <field name="groups" eval="[Command.link(ref('group_smartspend_user'))]"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_smartspend_request_bid_asked" model="ir.rule">
        <field name="name">SmartSpend: bids on requests I was asked about</field>
        <field name="model_id" ref="model_smartspend_request_bid"/>
        <field name="domain_force">[('request_id.clarification_user_id', '=', user.id)]</field>
        <field name="groups" eval="[Command.link(ref('group_smartspend_user'))]"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_smartspend_request_history_asked" model="ir.rule">
        <field name="name">SmartSpend: timeline of requests I was asked about</field>
        <field name="model_id" ref="model_smartspend_request_history"/>
        <field name="domain_force">[('request_id.clarification_user_id', '=', user.id)]</field>
        <field name="groups" eval="[Command.link(ref('group_smartspend_user'))]"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_smartspend_request_comment_asked" model="ir.rule">
        <field name="name">SmartSpend: clarifications I was asked about</field>
        <field name="model_id" ref="model_smartspend_request_comment"/>
        <field name="domain_force">[('request_id.clarification_user_id', '=', user.id)]</field>
        <field name="groups" eval="[Command.link(ref('group_smartspend_user'))]"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_smartspend_request_document_asked" model="ir.rule">
        <field name="name">SmartSpend: documents of requests I was asked about</field>
        <field name="model_id" ref="model_smartspend_request_document"/>
        <field name="domain_force">[('request_id.clarification_user_id', '=', user.id)]</field>
        <field name="groups" eval="[Command.link(ref('group_smartspend_user'))]"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- A manager can delegate an approval step to any internal user, not only
         another manager. That user has to read the request to decide it — read
         only; the decision goes through /api/smartspend/decide, which checks
         the step is still theirs. -->
    <record id="rule_smartspend_request_delegated" model="ir.rule">
        <field name="name">SmartSpend: requests delegated to me for approval</field>
        <field name="model_id" ref="model_smartspend_request"/>
        <field name="domain_force">[('approval_ids.delegate_user_id', '=', user.id)]</field>
        <field name="groups" eval="[Command.link(ref('group_smartspend_user'))]"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_smartspend_request_line_delegated" model="ir.rule">
        <field name="name">SmartSpend: lines of requests delegated to me</field>
        <field name="model_id" ref="model_smartspend_request_line"/>
        <field name="domain_force">[('request_id.approval_ids.delegate_user_id', '=', user.id)]</field>
        <field name="groups" eval="[Command.link(ref('group_smartspend_user'))]"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_smartspend_request_bid_delegated" model="ir.rule">
        <field name="name">SmartSpend: bids on requests delegated to me</field>
        <field name="model_id" ref="model_smartspend_request_bid"/>
        <field name="domain_force">[('request_id.approval_ids.delegate_user_id', '=', user.id)]</field>
        <field name="groups" eval="[Command.link(ref('group_smartspend_user'))]"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_smartspend_request_history_delegated" model="ir.rule">
        <field name="name">SmartSpend: timeline of requests delegated to me</field>
        <field name="model_id" ref="model_smartspend_request_history"/>
        <field name="domain_force">[('request_id.approval_ids.delegate_user_id', '=', user.id)]</field>
        <field name="groups" eval="[Command.link(ref('group_smartspend_user'))]"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_smartspend_request_comment_delegated" model="ir.rule">
        <field name="name">SmartSpend: clarifications on requests delegated to me</field>
        <field name="model_id" ref="model_smartspend_request_comment"/>
        <field name="domain_force">[('request_id.approval_ids.delegate_user_id', '=', user.id)]</field>
        <field name="groups" eval="[Command.link(ref('group_smartspend_user'))]"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_smartspend_request_document_delegated" model="ir.rule">
        <field name="name">SmartSpend: documents of requests delegated to me</field>
        <field name="model_id" ref="model_smartspend_request_document"/>
        <field name="domain_force">[('request_id.approval_ids.delegate_user_id', '=', user.id)]</field>
        <field name="groups" eval="[Command.link(ref('group_smartspend_user'))]"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_smartspend_request_company" model="ir.rule">
        <field name="name">SmartSpend: request multi-company</field>
        <field name="model_id" ref="model_smartspend_request"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>

    <record id="rule_smartspend_contract_company" model="ir.rule">
        <field name="name">SmartSpend: contract multi-company</field>
        <field name="model_id" ref="model_smartspend_contract"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>

    <!-- A vendor never reads these models directly: the supplier portal goes
         through the API, which shows each vendor their own standing only. -->
    <record id="rule_smartspend_auction_company" model="ir.rule">
        <field name="name">SmartSpend: reverse auction multi-company</field>
        <field name="model_id" ref="model_smartspend_auction"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>

    <!-- Favourite products: each user keeps their own; a procurement manager sees all. -->
    <record id="rule_smartspend_favorite_product_own" model="ir.rule">
        <field name="name">SmartSpend: own favourite products</field>
        <field name="model_id" ref="model_smartspend_favorite_product"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[Command.link(ref('group_smartspend_user'))]"/>
    </record>

    <record id="rule_smartspend_favorite_product_all" model="ir.rule">
        <field name="name">SmartSpend: all favourite products</field>
        <field name="model_id" ref="model_smartspend_favorite_product"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[Command.link(ref('group_smartspend_manager'))]"/>
    </record>

    <!-- Product creation requests: a requester sees their own; buyers and managers all. -->
    <record id="rule_smartspend_product_request_own" model="ir.rule">
        <field name="name">SmartSpend: own product creation requests</field>
        <field name="model_id" ref="model_smartspend_product_request"/>
        <field name="domain_force">[('requested_by_id', '=', user.id)]</field>
        <field name="groups" eval="[Command.link(ref('group_smartspend_user'))]"/>
    </record>

    <record id="rule_smartspend_product_request_all" model="ir.rule">
        <field name="name">SmartSpend: all product creation requests</field>
        <field name="model_id" ref="model_smartspend_product_request"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[Command.link(ref('group_smartspend_buyer'))]"/>
    </record>

</odoo>
