<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================== List -->
    <record id="smartspend_contract_view_list" model="ir.ui.view">
        <field name="name">smartspend.contract.list</field>
        <field name="model">smartspend.contract</field>
        <field name="arch" type="xml">
            <list string="Rate Contracts"
                  decoration-success="is_running"
                  decoration-muted="state in ('expired', 'cancel')">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="category" optional="show"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="lead_time" optional="hide"/>
                <field name="warranty" optional="hide"/>
                <field name="payment_terms" optional="hide"/>
                <field name="line_count" string="Rates"/>
                <field name="request_count" string="Requests" optional="hide"/>
                <field name="total_value" widget="monetary" optional="hide"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="is_running" string="Running" optional="show"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'active'"
                       decoration-muted="state in ('expired', 'cancel')"/>
            </list>
        </field>
    </record>

    <!-- ================================================== Form -->
    <record id="smartspend_contract_view_form" model="ir.ui.view">
        <field name="name">smartspend.contract.form</field>
        <field name="model">smartspend.contract</field>
        <field name="arch" type="xml">
            <form string="Rate Contract">
                <header>
                    <button name="action_activate" type="object" string="Activate"
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_expire" type="object" string="Expire"
                            invisible="state != 'active'"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state in ('cancel', 'expired')"/>
                    <button name="action_reset_draft" type="object" string="Reset to Draft"
                            invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active,expired"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" name="action_view_requests"
                                type="object" icon="fa-file-text-o"
                                invisible="request_count == 0">
                            <field name="request_count" widget="statinfo" string="Requests on Contract"/>
                        </button>
                        <button class="oe_stat_button" name="action_view_purchase_orders"
                                type="object" icon="fa-shopping-cart"
                                invisible="purchase_order_count == 0">
                            <field name="purchase_order_count" widget="statinfo" string="Orders on Contract"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Running" bg_color="text-bg-success"
                            invisible="not is_running"/>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Agreement">
                            <field name="partner_id"/>
                            <field name="category"/>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="is_running"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group string="Commitments">
                            <field name="lead_time"/>
                            <field name="warranty"/>
                            <field name="payment_terms"/>
                            <field name="total_value" widget="monetary"/>
                        </group>
                    </group>
                    <notebook>
                        <!-- First, so arriving from a request lands on the rates
                             that actually price it. Absent when the agreement is
                             opened from the menu, where the whole card is the point. -->
                        <page string="Rates for This Request" name="matched"
                              invisible="not matched_request_id">
                            <field name="matched_request_id" invisible="1"/>
                            <div class="alert alert-info mb-3" role="alert">
                                The rates below are the ones covering
                                <field name="matched_request_id" readonly="1" nolabel="1"
                                       options="{'no_open': False}" class="fw-bold"/>.
                                This agreement prices
                                <field name="line_count" readonly="1" nolabel="1" class="fw-bold"/>
                                products in all — see <b>Contracted Rates</b>.
                            </div>
                            <!-- The part of the request this card does not cover is
                                 the part still to be sourced: say so, don't let it
                                 be inferred from a count that looks complete. -->
                            <div class="alert alert-warning mb-3" role="alert"
                                 invisible="not matched_unpriced">
                                No rate here for
                                <field name="matched_unpriced" readonly="1" nolabel="1" class="fw-bold"/>
                                — that item still needs sourcing.
                            </div>
                            <field name="matched_line_ids" readonly="1">
                                <list create="false" delete="false">
                                    <field name="product_name"/>
                                    <field name="product_uom_id" string="Unit" optional="show"/>
                                    <field name="min_qty"/>
                                    <field name="price_unit" widget="monetary"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Contracted Rates" name="rates">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="product_name"/>
                                    <field name="product_id" optional="hide"/>
                                    <field name="product_uom_id" optional="hide" groups="uom.group_uom"/>
                                    <field name="min_qty"/>
                                    <field name="price_unit" widget="monetary"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Terms &amp; Notes" name="notes">
                            <field name="notes" placeholder="Negotiated terms, escalation clauses, penalties…"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ================================================== Search -->
    <!-- ================================================== Contract lines
         Standalone views: a request's rate-contract button opens the slice of
         a rate card that prices it, and that list needs views of its own. -->
    <record id="smartspend_contract_line_view_list" model="ir.ui.view">
        <field name="name">smartspend.contract.line.list</field>
        <field name="model">smartspend.contract.line</field>
        <field name="arch" type="xml">
            <list string="Contracted Rates" create="false" delete="false">
                <field name="contract_id"/>
                <field name="product_name"/>
                <field name="partner_id" string="Vendor"/>
                <field name="min_qty"/>
                <field name="product_uom_id" string="Unit" optional="show"/>
                <field name="price_unit" widget="monetary"/>
                <field name="is_running" string="Running" optional="hide"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="smartspend_contract_line_view_form" model="ir.ui.view">
        <field name="name">smartspend.contract.line.form</field>
        <field name="model">smartspend.contract.line</field>
        <field name="arch" type="xml">
            <form string="Contracted Rate">
                <sheet>
                    <group>
                        <group>
                            <field name="contract_id"/>
                            <field name="partner_id"/>
                            <field name="product_name"/>
                            <field name="product_id"/>
                        </group>
                        <group>
                            <field name="min_qty"/>
                            <field name="product_uom_id"/>
                            <field name="price_unit" widget="monetary"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="smartspend_contract_view_search" model="ir.ui.view">
        <field name="name">smartspend.contract.search</field>
        <field name="model">smartspend.contract</field>
        <field name="arch" type="xml">
            <search string="Rate Contracts">
                <field name="name" string="Contract"
                       filter_domain="['|', ('name', 'ilike', self), ('line_ids.product_name', 'ilike', self)]"/>
                <field name="partner_id"/>
                <field name="category"/>
                <filter name="running" string="Running" domain="[('is_running', '=', True)]"/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="expired" string="Expired" domain="[('state', '=', 'expired')]"/>
                <separator/>
                <filter name="expiring" string="Ending This Month" date="date_end"/>
                <group>
                    <filter name="group_partner" string="Vendor" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_category" string="Category" context="{'group_by': 'category'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ================================================== Action -->
    <record id="smartspend_contract_action" model="ir.actions.act_window">
        <field name="name">Rate Contracts</field>
        <field name="res_model">smartspend.contract</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="smartspend_contract_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Record your first rate contract
            </p>
            <p>
                Pre-negotiated rates are matched against every incoming purchase
                request, so a covered item never goes out for sourcing twice.
            </p>
        </field>
    </record>

</odoo>
