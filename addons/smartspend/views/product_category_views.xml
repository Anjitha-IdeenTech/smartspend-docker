<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Product categories, with the suppliers a reverse auction suggests for them. -->
    <record id="product_category_view_list_smartspend" model="ir.ui.view">
        <field name="name">product.category.list.smartspend</field>
        <field name="model">product.category</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <list string="Product Categories">
                <field name="complete_name" string="Product Category"/>
                <field name="smartspend_expense_category_ids" widget="many2many_tags" optional="show"/>
                <field name="smartspend_vendor_ids" widget="many2many_tags"/>
            </list>
        </field>
    </record>

    <record id="product_category_view_form_smartspend" model="ir.ui.view">
        <field name="name">product.category.form.smartspend</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="product.product_category_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="SmartSpend Vendors">
                    <field name="smartspend_vendor_ids" widget="many2many_tags" nolabel="1" colspan="2"
                           placeholder="Suppliers suggested when bidding on this category"
                           options="{'no_create': True}"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="smartspend_product_category_action" model="ir.actions.act_window">
        <field name="name">Product Categories</field>
        <field name="res_model">product.category</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[Command.clear(),
            Command.create({'view_mode': 'list', 'view_id': ref('product_category_view_list_smartspend')}),
            Command.create({'view_mode': 'form', 'view_id': ref('product.product_category_form_view')})]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a product category</p>
            <p>Assign the vendors who supply it; they are suggested when a buyer invites vendors to a reverse auction.</p>
        </field>
    </record>

</odoo>
