<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- What each user keeps one tap away on the portal. -->
    <record id="smartspend_favorite_product_view_list" model="ir.ui.view">
        <field name="name">smartspend.favorite.product.list</field>
        <field name="model">smartspend.favorite.product</field>
        <field name="arch" type="xml">
            <list string="Favourite Products" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="user_id"/>
                <field name="product_name"/>
                <field name="category_id" optional="show"/>
                <field name="default_qty"/>
                <field name="target_price"/>
                <field name="note" optional="show"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="smartspend_favorite_product_view_search" model="ir.ui.view">
        <field name="name">smartspend.favorite.product.search</field>
        <field name="model">smartspend.favorite.product</field>
        <field name="arch" type="xml">
            <search string="Favourite Products">
                <field name="product_name"/>
                <field name="user_id"/>
                <filter name="mine" string="My Favourites" domain="[('user_id', '=', uid)]"/>
                <filter name="group_user" string="User" context="{'group_by': 'user_id'}"/>
            </search>
        </field>
    </record>

    <record id="smartspend_favorite_product_action" model="ir.actions.act_window">
        <field name="name">Favourite Products</field>
        <field name="res_model">smartspend.favorite.product</field>
        <field name="view_mode">list</field>
        <field name="context">{'search_default_group_user': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No favourites yet</p>
            <p>Users star the products they order often on the portal, and raise a request from them in one tap.</p>
        </field>
    </record>

    <!-- Named sets of products a user orders together. -->
    <record id="smartspend_favorite_group_view_list" model="ir.ui.view">
        <field name="name">smartspend.favorite.group.list</field>
        <field name="model">smartspend.favorite.group</field>
        <field name="arch" type="xml">
            <list string="Favourite Groups">
                <field name="sequence" widget="handle"/>
                <field name="user_id"/>
                <field name="name"/>
                <field name="item_ids" widget="many2many_tags" string="Products"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="smartspend_favorite_group_view_form" model="ir.ui.view">
        <field name="name">smartspend.favorite.group.form</field>
        <field name="model">smartspend.favorite.group</field>
        <field name="arch" type="xml">
            <form string="Favourite Group">
                <sheet>
                    <div class="oe_title"><h1><field name="name" placeholder="e.g. New joiner kit"/></h1></div>
                    <group><field name="user_id"/></group>
                    <field name="item_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="product_name"/>
                            <field name="quantity"/>
                            <field name="target_price"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="smartspend_favorite_group_action" model="ir.actions.act_window">
        <field name="name">Favourite Groups</field>
        <field name="res_model">smartspend.favorite.group</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No favourite groups yet</p>
            <p>Users group products they order together on the portal, and add the whole group to a request in one go.</p>
        </field>
    </record>

</odoo>
