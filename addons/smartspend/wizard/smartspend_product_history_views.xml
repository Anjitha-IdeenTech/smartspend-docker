<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- What this product has cost before: the three headline numbers, then
         the rows they came from. Opened from the history button on a request
         line or an order line. -->
    <record id="smartspend_product_history_view_form" model="ir.ui.view">
        <field name="name">smartspend.product.history.form</field>
        <field name="model">smartspend.product.history</field>
        <field name="arch" type="xml">
            <form string="Product History">
                <field name="currency_id" invisible="1"/>
                <div class="oe_title">
                    <h2><field name="product_name" readonly="1" nolabel="1"/></h2>
                    <div class="text-muted" invisible="not branch">
                        Prices seen for <field name="branch" readonly="1" nolabel="1" class="oe_inline"/>
                    </div>
                </div>

                <group>
                    <group string="On contract">
                        <field name="contracted_rate" widget="monetary"/>
                        <field name="contracted_partner_id"/>
                    </group>
                    <group string="Actually paid">
                        <field name="last_paid" widget="monetary"/>
                        <field name="last_paid_on"/>
                        <field name="last_partner_id"/>
                        <field name="average_paid" widget="monetary"/>
                        <field name="best_paid" widget="monetary"/>
                        <field name="best_partner_id"/>
                        <field name="order_qty"/>
                    </group>
                </group>

                <notebook>
                    <page string="Rate Contracts" name="contracts">
                        <field name="contract_line_ids" readonly="1" nolabel="1">
                            <list create="false" delete="false" edit="false">
                                <field name="partner_id"/>
                                <field name="contract_id"/>
                                <field name="price_unit" widget="monetary"/>
                                <field name="min_qty" optional="show"/>
                                <field name="lead_time" optional="show"/>
                                <field name="payment_terms" optional="hide"/>
                                <field name="date_end"/>
                                <field name="currency_id" column_invisible="1"/>
                            </list>
                        </field>
                    </page>
                    <page string="Purchase Orders" name="orders">
                        <field name="order_line_ids" readonly="1" nolabel="1">
                            <list create="false" delete="false" edit="false">
                                <field name="date_order"/>
                                <field name="order_id"/>
                                <field name="partner_id"/>
                                <field name="product_qty" sum="Quantity"/>
                                <field name="price_unit" widget="monetary"/>
                                <field name="price_subtotal" widget="monetary" sum="Total"/>
                                <field name="request_ref" optional="show"/>
                                <field name="state" optional="hide"/>
                                <field name="currency_id" column_invisible="1"/>
                            </list>
                        </field>
                    </page>
                    <page string="Requests" name="requests">
                        <field name="request_line_ids" readonly="1" nolabel="1">
                            <list create="false" delete="false" edit="false">
                                <field name="request_date"/>
                                <field name="request_id"/>
                                <field name="user_id"/>
                                <field name="branch" optional="show"/>
                                <field name="product_qty" sum="Quantity"/>
                                <field name="price_unit" widget="monetary"/>
                                <field name="state"/>
                                <field name="currency_id" column_invisible="1"/>
                            </list>
                        </field>
                    </page>
                </notebook>

                <footer>
                    <button string="Close" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
